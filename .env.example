# ========================================================
# Next Category Prediction API Configuration
# ========================================================

# Pilihan 1: Google Gemini API (Sangat Direkomendasikan)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pilihan 2: Groq API Key (Opsional fallback)
# Dapatkan di: https://console.groq.com/keys
# GROQ_API_KEY=

# URL Backend untuk Frontend (default: /api untuk Vercel / Vite Proxy)
# VITE_API_BASE_URL=/api
